-- ================= MOVEMENT =================
local flight = { active = false }

local function safeState(s)
	if not (hum and hum.Parent) then return end
	pcall(function() hum:ChangeState(s) end)
end

local function groundAt(p)
	local pr = RaycastParams.new()
	pr.FilterType = Enum.RaycastFilterType.Exclude
	pr.FilterDescendantsInstances = { char }
	local h = workspace:Raycast(p + Vector3.new(0, 80, 0), Vector3.new(0, -900, 0), pr)
	if h then return h.Position + Vector3.new(0, 4, 0) end
	return p
end

local function flyTo(dest, liftCap)
	if flight.active then return false end
	refresh()
	if not (root and hum and root.Parent) then return false end
	flight.active = true

	local from = root.Position
	local flat = Vector3.new(dest.X - from.X, 0, dest.Z - from.Z).Magnitude
	local spd = math.max((CFG.spOn and CFG.spVal or hum.WalkSpeed) * CFG.speedMul, 45)
	local dur = math.clamp(flat / spd, 0.25, 8)
	local lift = math.clamp(flat * CFG.liftMul, 5, liftCap or CFG.liftCap)
	local steps = math.clamp(math.floor(dur / 0.03), 12, 300)
	local dir = dest - from
	if dir.Magnitude <= 0.1 then dir = Vector3.new(0, 0, -1) else dir = dir.Unit end

	local ok = true
	for i = 1, steps do
		if not (root and root.Parent) then ok = false break end
		local t = i / steps
		local pos = from:Lerp(dest, t) + Vector3.new(0, math.sin(t * math.pi) * lift, 0)
		root.CFrame = CFrame.lookAt(pos, pos + dir)
		if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
		task.wait(dur / steps)
	end
	if ok and root and root.Parent then
		root.CFrame = CFrame.new(groundAt(dest))
		root.AssemblyLinearVelocity = Vector3.zero
		safeState(Enum.HumanoidStateType.Running)
	else ok = false end
	flight.active = false
	return ok
end

local function goHome()
	if not CFG.pin then return false end
	return flyTo(CFG.pin.Position, 450)
end

-- ================= EGG SCANNER =================
local eggs = {}

local function partOf(o)
	if o:IsA("BasePart") then return o end
	return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
end

local function scanEggs()
	eggs = {}
	refresh()
	if not root then return eggs end
	local kw = CFG.keyword:lower()
	if kw == "" then kw = "egg" end
	local seen = {}
	local function collect(o)
		local rp = partOf(o)
		if not rp then return end
		local key = string.format("%d_%d_%d", math.floor(rp.Position.X/2), math.floor(rp.Position.Y/2), math.floor(rp.Position.Z/2))
		if seen[key] then return end
		seen[key] = true
		eggs[#eggs+1] = { instance = o, position = rp.Position, name = o.Name, distance = (rp.Position - root.Position).Magnitude }
	end
	for _, t in ipairs(CollectionService:GetTagged("Egg")) do
		if t.Name:lower():find(kw) then collect(t) end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		if (d:IsA("Model") or d:IsA("BasePart")) and d.Name:lower():find(kw) then collect(d) end
	end
	table.sort(eggs, function(a, b) return a.distance > b.distance end)
	return eggs
end

local function nearestEgg()
	for i = #eggs, 1, -1 do
		if eggs[i].instance and eggs[i].instance.Parent then return eggs[i] end
	end
	return nil
end

