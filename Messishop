local C = {
	bg = Color3.fromRGB(18,18,27), panel = Color3.fromRGB(30,30,42), alt = Color3.fromRGB(40,40,55),
	accent = Color3.fromRGB(255,200,55), brand = Color3.fromRGB(132,26,155), brandDk = Color3.fromRGB(58,10,76),
	text = Color3.fromRGB(240,240,248), dim = Color3.fromRGB(150,150,170),
	ok = Color3.fromRGB(40,175,95), off = Color3.fromRGB(70,70,88), danger = Color3.fromRGB(190,50,50),
}

local function shade(c, a)
	return Color3.fromRGB(
		math.max(math.floor(c.R*255-a),0),
		math.max(math.floor(c.G*255-a),0),
		math.max(math.floor(c.B*255-a),0))
end
local function mk(class, props, parent)
	local i = Instance.new(class)
	if props then for k, v in pairs(props) do i[k] = v end end
	if parent then i.Parent = parent end
	return i
end
local function rnd(i, r) mk("UICorner", { CornerRadius = UDim.new(0, r or 8) }, i) end
local function strk(i, c, t) mk("UIStroke", { Color = c or Color3.new(0,0,0), Thickness = t or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, i) end
local function grd(i, c1, c2, r) mk("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = r or 90 }, i) end
local function tw(i, p, t)
	local a = TweenService:Create(i, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p)
	a:Play() return a
end
local function cst(i, mx, mn) mk("UITextSizeConstraint", { MaxTextSize = mx, MinTextSize = mn or 8 }, i) end
local function lbl(parent, text, size, color, font)
	return mk("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size,
		TextColor3 = color or C.text, Font = font or Enum.Font.Gotham,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1,0,1,0),
	}, parent)
end

