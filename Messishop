local function togg(parent, text, default, onChange)
	local val = default and true or false
	local row = mk("Frame", { Size = UDim2.new(1,0,0,36), BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
	rnd(row, 8) strk(row)
	local t = lbl(row, text, 13)
	t.Position = UDim2.new(0,10,0,0) t.Size = UDim2.new(1,-70,1,0) cst(t, 13, 9)
	local track = mk("Frame", { Size = UDim2.new(0,46,0,24), Position = UDim2.new(1,-54,0.5,-12), BackgroundColor3 = val and C.ok or C.off, BorderSizePixel = 0 }, row)
	rnd(track, 12) strk(track)
	local knob = mk("Frame", { Size = UDim2.new(0,18,0,18), Position = UDim2.new(val and 1 or 0, val and -21 or 3, 0.5,-9), BackgroundColor3 = C.text, BorderSizePixel = 0 }, track)
	rnd(knob, 9)
	local obj = {}
	function obj.Set(v)
		val = v and true or false
		tw(track, { BackgroundColor3 = val and C.ok or C.off })
		tw(knob, { Position = UDim2.new(val and 1 or 0, val and -21 or 3, 0.5,-9) })
		if onChange then onChange(val) end
	end
	row.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then obj.Set(not val) end
	end)
	return obj
end

local function fmt(n)
	if n == math.floor(n) then return tostring(math.floor(n)) end
	return string.format("%.2f", n)
end

local function slider(parent, text, min, max, default, step, onChange)
	local val, st = default or min, step or 1
	local row = mk("Frame", { Size = UDim2.new(1,0,0,54), BackgroundTransparency = 1 }, parent)
	local cap = mk("TextLabel", {
		BackgroundTransparency = 1, Text = "", TextSize = 12, TextColor3 = C.text,
		Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1,0,0,18), Position = UDim2.new(0,2,0,0),
	}, row)
	cst(cap, 12, 8)
	local track = mk("Frame", { Size = UDim2.new(1,-14,0,8), Position = UDim2.new(0,7,0,32), BackgroundColor3 = C.panel, BorderSizePixel = 0, Active = true }, row)
	rnd(track, 4)
	local fill = mk("Frame", { Size = UDim2.new(0,0,1,0), BackgroundColor3 = C.accent, BorderSizePixel = 0 }, track)
	rnd(fill, 4)
	local thumb = mk("TextButton", { Size = UDim2.new(0,20,0,20), Position = UDim2.new(0,-10,0.5,-10), BackgroundColor3 = C.text, Text = "", BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 3 }, track)
	rnd(thumb, 10) strk(thumb, nil, 2)
	local obj, dragging = {}, false
	local function render(v, silent)
		val = math.clamp(v, min, max)
		val = math.floor(val / st) * st
		local pct = (max-min) ~= 0 and math.clamp((val-min)/(max-min), 0, 1) or 0
		fill.Size = UDim2.new(pct,0,1,0)
		thumb.Position = UDim2.new(pct,-10,0.5,-10)
		cap.Text = string.format("%s   %s", text, fmt(val))
		if not silent and onChange then onChange(val) end
	end
	local function fromPtr(x)
		local size = track.AbsoluteSize.X
		if size <= 0 then return end
		render(min + ((x - track.AbsolutePosition.X)/size) * (max-min))
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true fromPtr(i.Position.X)
		end
	end)
	thumb.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then fromPtr(i.Position.X) end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	obj.Set = function(v) render(v, false) end
	obj.Get = function() return val end
	render(val, true)
	return obj
end

local function txtbox(parent, text, ph, onSubmit)
	local b = mk("TextBox", {
		Size = UDim2.new(1,0,0,36), BackgroundColor3 = C.panel,
		Text = text or "", PlaceholderText = ph or "",
		TextColor3 = C.accent, PlaceholderColor3 = C.dim,
		TextSize = 13, Font = Enum.Font.GothamBold,
		ClearTextOnFocus = false, BorderSizePixel = 0,
	}, parent)
	rnd(b, 8) strk(b) cst(b, 13, 9)
	b.FocusLost:Connect(function(e) if e and onSubmit then onSubmit(b.Text) end end)
	return b
end

local function readout(parent, text, color)
	local row = mk("Frame", { Size = UDim2.new(1,0,0,34), BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
	rnd(row, 8) strk(row)
	local t = lbl(row, text, 12, color or C.accent, Enum.Font.GothamBold)
	t.Position = UDim2.new(0,10,0,0) t.Size = UDim2.new(1,-20,1,0)
	t.TextTruncate = Enum.TextTruncate.AtEnd cst(t, 12, 8)
	return { Set = function(_, v) t.Text = tostring(v) end }
end

local function header(parent, text)
	local t = lbl(parent, text, 13, C.accent, Enum.Font.GothamBold)
	t.Position = UDim2.new(0,4,0,0) t.Size = UDim2.new(1,-8,0,22)
	cst(t, 13, 9) return t
end

